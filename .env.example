# Discord Developer Portal の Bot Token
DISCORD_TOKEN=replace-me

# この1サーバー・1チャンネルだけを聞きます
TARGET_GUILD_ID=123456789012345678
TARGET_CHANNEL_ID=234567890123456789

DATABASE_PATH=data/memory.sqlite3
SEED_CORPUS_PATH=corpus/real_persona_chat.txt
SEED_CORPUS_WEIGHT=0.15

# 対象サーバー内の、対象外チャンネルで反応する言葉
TRIGGER_WORDS=神,仏

# normal / casual / samurai
BOT_PERSONA=casual

# Reudy互換の学習・検索設定
MEMORY_RETENTION_DAYS=90
MAX_MESSAGES_PER_CHANNEL=10000
CANDIDATE_POOL_SIZE=10000
RECENT_UNUSED_MESSAGES=20
REPEAT_PROOF_MESSAGES=50
REPLY_COOLDOWN_SECONDS=5
MAX_MESSAGE_LENGTH=500
MAX_REPLY_SOURCE_LENGTH=20
RESPONSE_DRIFT_RATE=0.85
WORD_SPLICE_RATE=0.0
WORD_MUTATION_RATE=0.35
CUTE_TONE_RATE=0.35
